# Neon / Supabase PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Used to sign JWTs — generate with: openssl rand -base64 32
JWT_SECRET=change_me

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match the "Authorization callback URL" in the GitHub OAuth app
GITHUB_CALLBACK_URL=https://your-app.vercel.app/api/login/github/callback

# Where to redirect after a successful GitHub login
FRONTEND_URL=https://your-app.vercel.app

# Cloudinary (https://cloudinary.com) for avatar / post image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional, defaults to 8080 locally
PORT=8080
